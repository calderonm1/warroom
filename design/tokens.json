{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "War Room design tokens. Source of truth for UI colours, type, spacing, radius and motion. Generated into Unity USS variables by ST-11.1.1. See docs/04-ux/design-system.md.",
  "color": {
    "bg": {
      "base": { "$type": "color", "$value": "#0B0F14" },
      "surface": { "$type": "color", "$value": "#121821" },
      "elevated": { "$type": "color", "$value": "#1A2230" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#263142" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#E6EDF5" },
      "secondary": { "$type": "color", "$value": "#9AA8BA" },
      "disabled": { "$type": "color", "$value": "#5B6878" }
    },
    "accent": {
      "primary": { "$type": "color", "$value": "#3FA7FF" },
      "warning": { "$type": "color", "$value": "#FFB020" },
      "danger": { "$type": "color", "$value": "#FF4D5E" },
      "success": { "$type": "color", "$value": "#3DDC97" }
    },
    "ocean": {
      "deep": { "$type": "color", "$value": "#0A1A2B" },
      "shallow": { "$type": "color", "$value": "#12324F" }
    },
    "coalition": {
      "1": { "$type": "color", "$value": "#E69F00" },
      "2": { "$type": "color", "$value": "#56B4E9" },
      "3": { "$type": "color", "$value": "#009E73" },
      "4": { "$type": "color", "$value": "#F0E442" },
      "5": { "$type": "color", "$value": "#0072B2" },
      "6": { "$type": "color", "$value": "#D55E00" },
      "7": { "$type": "color", "$value": "#CC79A7" },
      "8": { "$type": "color", "$value": "#BBBBBB" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Barlow Condensed" },
      "ui": { "$type": "fontFamily", "$value": "Inter" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "32px" },
      "title": { "$type": "dimension", "$value": "20px" },
      "body": { "$type": "dimension", "$value": "15px" },
      "label": { "$type": "dimension", "$value": "13px" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "touch-target-min": { "$type": "dimension", "$value": "44px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "slow": { "$type": "duration", "$value": "350ms" },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  }
}
