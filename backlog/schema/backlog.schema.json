{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warroom.invalid/schemas/backlog-epic.json",
  "title": "War Room backlog epic file",
  "description": "One file per epic: backlog/epics/EP-NN-<slug>.yaml. See backlog/README.md and ADR-0014.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "milestone", "priority", "summary", "features"],
  "properties": {
    "id": { "$ref": "#/$defs/epicId" },
    "title": { "$ref": "#/$defs/title" },
    "milestone": { "$ref": "#/$defs/milestone" },
    "priority": { "$ref": "#/$defs/priority" },
    "summary": { "type": "string", "minLength": 20 },
    "outcome": {
      "type": "string",
      "description": "What is true when the epic is done."
    },
    "docs": { "$ref": "#/$defs/docList" },
    "refs": { "$ref": "#/$defs/refList" },
    "labels": { "$ref": "#/$defs/labelList" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "epicId": { "type": "string", "pattern": "^EP-\\d{2}$" },
    "featureId": { "type": "string", "pattern": "^FE-\\d{2}\\.\\d+$" },
    "storyId": { "type": "string", "pattern": "^ST-\\d{2}\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "milestone": { "type": "string", "pattern": "^M[0-9]$" },
    "priority": {
      "description": "P0 = blocks the milestone; P1 = needed for the milestone; P2 = should have; P3 = nice to have.",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "size": {
      "description": "Relative size (docs/07-planning/effort.md). XL must be split before it can be ready.",
      "enum": ["XS", "S", "M", "L", "XL"]
    },
    "status": {
      "enum": ["draft", "ready", "in-progress", "blocked", "done", "cancelled"]
    },
    "type": {
      "enum": ["feature", "chore", "spike", "docs", "infra", "test", "bug"]
    },
    "docList": {
      "description": "Repo-relative paths, optionally with #anchor. Paths must exist.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-/]+(#[A-Za-z0-9_\\-]+)?$" },
      "uniqueItems": true
    },
    "refList": {
      "description": "Requirement and decision IDs (ADR-NNNN, GDD-*, SIM-*, NFR-*, BR-*, PR-*, SCR-*, GLB-*, KPI-*, CONV-*, RISK-*, OQ-*). Must be defined somewhere in docs/.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(ADR-\\d{4}|GDD-[A-Z]+-\\d{3}|SIM-\\d{3}|NFR-[A-Z]+-\\d{3}[a-z]?|BR-\\d{3}|PR-\\d{3}|SCR-\\d{3}|GLB-\\d{3}|KPI-\\d{2}|CONV-[A-Z]+-\\d{3}|RISK-\\d{3}|OQ-\\d{3})$"
      },
      "uniqueItems": true
    },
    "labelList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]*$" },
      "uniqueItems": true
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "stories"],
      "properties": {
        "id": { "$ref": "#/$defs/featureId" },
        "title": { "$ref": "#/$defs/title" },
        "summary": { "type": "string", "minLength": 10 },
        "milestone": { "$ref": "#/$defs/milestone" },
        "docs": { "$ref": "#/$defs/docList" },
        "refs": { "$ref": "#/$defs/refList" },
        "stories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/story" }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "status", "priority", "size", "story", "acceptance_criteria"],
      "properties": {
        "id": { "$ref": "#/$defs/storyId" },
        "title": { "$ref": "#/$defs/title" },
        "type": { "$ref": "#/$defs/type" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "size": { "$ref": "#/$defs/size" },
        "milestone": {
          "$ref": "#/$defs/milestone",
          "description": "Overrides the feature or epic milestone."
        },
        "story": {
          "type": "string",
          "minLength": 20,
          "description": "As a <role>, I want <capability>, so that <benefit>."
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10,
            "description": "Testable statement, preferably Given/When/Then."
          }
        },
        "docs": { "$ref": "#/$defs/docList" },
        "refs": { "$ref": "#/$defs/refList" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/storyId" },
          "uniqueItems": true
        },
        "labels": { "$ref": "#/$defs/labelList" },
        "agent_notes": {
          "type": "string",
          "description": "Plans, decisions and gotchas recorded by whoever works the story (CONV-AI-006)."
        }
      }
    }
  }
}
